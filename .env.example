# PostgreSQL connection URL used by Prisma (prisma7.config.ts) and the import/seed scripts.
# Salin file ini menjadi .env lalu isi koneksi PostgreSQL lokal Anda.
# Contoh: postgresql://<user>:<password>@localhost:5432/funfootball
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/funfootball"